# labs/ch05/sample-data.ttl
# A small, self-contained slice of the materialized Customer 360 graph,
# standing in for the Chapter 4 Delta table (ontobricks.customer360.triples)
# so the lab can be run and verified locally without a Databricks workspace.
#
# As written, this graph CONFORMS to shapes.ttl. The verification step
# (validate.py --break) deletes Customer4471's isLocatedIn edge to prove the
# inspector catches a semantic defect that no null/type check would see.

@prefix c360: <https://ontobricks.example/customer360#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#### Regions and regulation ####
c360:RegionEMEA  a c360:Region ;
    c360:governedBy c360:GDPR .
c360:GDPR  a c360:Regulation .

#### Customer4471 — premium, EMEA, LTV 18,400, escalated ticket ####
c360:Customer4471  a c360:Customer , c360:PremiumCustomer ;
    c360:hasLifetimeValue "18400"^^xsd:decimal ;
    c360:isLocatedIn  c360:RegionEMEA ;
    c360:hasAccount   c360:Account4471 ;
    c360:hadInteraction c360:Interaction001 ;
    c360:raised       c360:Ticket7781 .

c360:Account4471  a c360:Account ;
    c360:status "active" ;
    c360:createdAt "2024-02-11T09:00:00Z"^^xsd:dateTime .

c360:Ticket7781  a c360:SupportTicket ;
    c360:status "escalated" ;
    c360:escalatedTo c360:Account4471 .

c360:Interaction001 a c360:Interaction ;
    c360:createdAt "2026-06-01T14:22:00Z"^^xsd:dateTime .

#### Customer5500 — ordinary, AMER, low LTV ####
c360:RegionAMER  a c360:Region .

c360:Customer5500  a c360:Customer ;
    c360:hasLifetimeValue "3200"^^xsd:decimal ;
    c360:isLocatedIn c360:RegionAMER ;
    c360:hasAccount  c360:Account5500 ;
    c360:hadInteraction c360:Interaction002 .

c360:Account5500  a c360:Account ;
    c360:status "active" ;
    c360:createdAt "2025-09-30T11:10:00Z"^^xsd:dateTime .

c360:Interaction002 a c360:Interaction ;
    c360:createdAt "2026-05-20T08:05:00Z"^^xsd:dateTime .
