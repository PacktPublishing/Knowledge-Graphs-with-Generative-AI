# labs/ch05/shapes.ttl
# SHACL shapes for the Customer 360 graph (Chapter 5).
# Consumes: the materialized Customer 360 triples from Chapter 4, validated
#           against the customer360.ttl ontology from Chapter 3.
# Produces: validation findings (see validate.py) written back as graph-native
#           triples and surfaced to a Databricks SQL / Lakeview dashboard.
#
# Validate with pySHACL:  pyshacl -s shapes.ttl -df turtle data.ttl
# (advanced mode is required for the SPARQL-based constraint below).

@prefix c360: <https://ontobricks.example/customer360#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# 1. Customer: must have exactly one Region; should have an interaction.
#################################################################
c360:CustomerShape  a sh:NodeShape ;
    sh:targetClass c360:Customer ;

    # Every Customer must be located in exactly one Region.            [Violation]
    sh:property [
        sh:path     c360:isLocatedIn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    c360:Region ;
        sh:message  "A Customer must be located in exactly one Region." ;
        sh:severity sh:Violation ;
    ] ;

    # A Customer with no recorded interaction is usable but stale.      [Warning]
    sh:property [
        sh:path     c360:hadInteraction ;
        sh:minCount 1 ;
        sh:message  "Customer has no recorded interaction." ;
        sh:severity sh:Warning ;
    ] .

#################################################################
# 2. Account: status drawn from a controlled vocabulary; one createdAt.
#################################################################
c360:AccountShape  a sh:NodeShape ;
    sh:targetClass c360:Account ;

    sh:property [
        sh:path     c360:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in       ( "active" "suspended" "closed" ) ;
        sh:message  "Account status must be one of: active, suspended, closed." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path     c360:createdAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message  "Account createdAt must be a single xsd:dateTime." ;
        sh:severity sh:Warning ;
    ] .

#################################################################
# 3. SupportTicket: may only escalate to an account a customer owns.
#    Relational rule expressed with a shape reference + inverse path.
#################################################################
c360:TicketEscalationShape  a sh:NodeShape ;
    sh:targetClass c360:SupportTicket ;
    sh:property [
        sh:path     c360:escalatedTo ;
        sh:node     c360:OwnedAccountShape ;
        sh:message  "A ticket may only be escalated to an account owned by a customer." ;
        sh:severity sh:Violation ;
    ] .

c360:OwnedAccountShape  a sh:NodeShape ;
    sh:property [
        sh:path     [ sh:inversePath c360:hasAccount ] ;   # who hasAccount -> this?
        sh:minCount 1 ;
        sh:message  "This account is not owned by any customer." ;
        sh:severity sh:Violation ;
    ] .

#################################################################
# 4. Premium consistency: LTV over €15,000 must be typed PremiumCustomer.
#    A correlation between two properties -> SPARQL-based constraint.
#################################################################
c360:PremiumConsistencyShape  a sh:NodeShape ;
    sh:targetClass c360:Customer ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message  "Customer's lifetime value exceeds EUR 15,000 but she is not typed PremiumCustomer." ;
        sh:severity sh:Violation ;
        sh:prefixes c360: ;
        sh:select """
            SELECT $this WHERE {
                $this  c360:hasLifetimeValue  ?ltv .
                FILTER ( ?ltv > 15000 )
                FILTER NOT EXISTS { $this rdf:type c360:PremiumCustomer . }
            }
        """ ;
    ] .

#################################################################
# 5. Premium watch: a very high-value premium customer is worth noting.
#################################################################
c360:PremiumWatchShape  a sh:NodeShape ;
    sh:targetClass c360:PremiumCustomer ;
    sh:property [
        sh:path        c360:hasLifetimeValue ;
        sh:minInclusive 50000 ;
        sh:message     "Premium customer above EUR 50,000 - candidate for key-account review." ;
        sh:severity    sh:Info ;
    ] .

# The c360: prefix declaration the SPARQL constraint references via sh:prefixes.
c360: a <http://www.w3.org/ns/shacl#PrefixDeclaration> ;
    sh:declare [
        sh:prefix    "c360" ;
        sh:namespace "https://ontobricks.example/customer360#"^^xsd:anyURI ;
    ] ;
    sh:declare [
        sh:prefix    "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] .
