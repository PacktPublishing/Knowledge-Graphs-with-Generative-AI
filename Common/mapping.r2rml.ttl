# mapping.r2rml.ttl
# ---------------------------------------------------------------------------
# Chapter 4 — From Tables to Triples: R2RML and Mapping
# Knowledge Graphs for AI Agents — Benoît Cayla
#
# CONSUMES : labs/ch03/customer360.ttl  (the Customer 360 ontology, Chapter 3)
#            Unity Catalog tables in  ontobricks.customer360
# PRODUCES : the rules that turn the relational tables into c360: triples.
#            Run by labs/ch04/materialize.py to produce the materialized graph.
#
# This is a hand-written R2RML mapping (W3C Recommendation, 2012). It maps four
# tables — customers, accounts, orders, order_items — to the classes and
# properties of the Customer 360 ontology. Every IRI template below builds a
# stable, global identifier from a relational primary key, so that the same
# real-world thing always receives the same IRI no matter how many times we run.
#
# Base IRI for the data:  https://ontobricks.example/customer360#
# Replace `ontobricks.example` with your own domain in production.
# ---------------------------------------------------------------------------

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix c360: <https://ontobricks.example/customer360#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# ===========================================================================
# 1. CUSTOMERS  →  c360:Customer
#    customers(customer_id, full_name, lifetime_value, status, created_at,
#              region_code)
# ===========================================================================
<#CustomerMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.customers" ] ;

    # Subject: one c360:Customer per row, IRI built from the primary key.
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Customer{customer_id}" ;
        rr:class    c360:Customer
    ] ;

    # Datatype property: lifetime value as an xsd:decimal (EUR).
    rr:predicateObjectMap [
        rr:predicate c360:hasLifetimeValue ;
        rr:objectMap [ rr:column "lifetime_value" ; rr:datatype xsd:decimal ]
    ] ;

    # Datatype property: account status as a plain string literal.
    rr:predicateObjectMap [
        rr:predicate c360:status ;
        rr:objectMap [ rr:column "status" ]
    ] ;

    # Datatype property: creation timestamp.
    rr:predicateObjectMap [
        rr:predicate c360:createdAt ;
        rr:objectMap [ rr:column "created_at" ; rr:datatype xsd:dateTime ]
    ] ;

    # Object property: a Customer isLocatedIn a Region.
    # The object is an IRI built from the region_code in this same table —
    # no join needed, because the foreign key lives on the customer row.
    rr:predicateObjectMap [
        rr:predicate c360:isLocatedIn ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Region{region_code}"
        ]
    ] .

# ===========================================================================
# 2. ACCOUNTS  →  c360:Account, linked to its Customer via c360:hasAccount
#    accounts(account_id, customer_id, status, created_at)
# ===========================================================================
<#AccountMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.accounts" ] ;

    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Account{account_id}" ;
        rr:class    c360:Account
    ] ;

    rr:predicateObjectMap [
        rr:predicate c360:status ;
        rr:objectMap [ rr:column "status" ]
    ] .

# The hasAccount edge (Customer → Account) is declared on the customer side
# so that the customer IRI is the subject. The object IRI is built from the
# foreign key on the accounts row, again with no SQL join required.
<#CustomerAccountMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.accounts" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Customer{customer_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate c360:hasAccount ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Account{account_id}"
        ]
    ] .

# ===========================================================================
# 3. ORDERS  →  c360:Order, linked to its Customer via c360:placed
#    orders(order_id, customer_id, status, created_at)
# ===========================================================================
<#OrderMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.orders" ] ;

    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Order{order_id}" ;
        rr:class    c360:Order
    ] ;

    rr:predicateObjectMap [
        rr:predicate c360:status ;
        rr:objectMap [ rr:column "status" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate c360:createdAt ;
        rr:objectMap [ rr:column "created_at" ; rr:datatype xsd:dateTime ]
    ] ;

    # The inverse placedBy edge (Order → Customer). The foreign key customer_id
    # lives on the order row, so the object IRI is built straight from this
    # table with no join. The canonical c360:placed direction (Customer → Order)
    # is produced by <#CustomerOrderMap> below.
    rr:predicateObjectMap [
        rr:predicate c360:placedBy ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Customer{customer_id}"
        ]
    ] .

# The canonical c360:placed edge (Customer placed Order) modelled with the
# Customer as subject, so the through-line listing in Chapter 1 holds exactly.
<#CustomerOrderMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.orders" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Customer{customer_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate c360:placed ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Order{order_id}"
        ]
    ] .

# ===========================================================================
# 4. ORDER_ITEMS  →  the c360:contains edge (Order → Product)
#    order_items(order_id, product_id, quantity)
#    This is the line-item join table. We need the Order IRI as subject and a
#    Product IRI as object — both built from columns on the SAME row, so this
#    is again template-only. The genuine cross-table JOIN example follows.
# ===========================================================================
<#OrderItemMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.order_items" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Order{order_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate c360:contains ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Product{product_id}"
        ]
    ] .

# ===========================================================================
# 5. A REAL JOIN  →  enrich each Order with the placing customer's region.
#    Here the two columns we need (the order, and the customer's region) live
#    in DIFFERENT tables, so we use rr:parentTriplesMap + rr:joinCondition.
#    This produces: c360:Order{id}  c360:orderedFromRegion  c360:Region{code}
#    by joining orders.customer_id = customers.customer_id and reading the
#    region_code off the parent customer row.
# ===========================================================================
<#OrderRegionJoinMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.orders" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Order{order_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate c360:orderedFromRegion ;
        rr:objectMap [
            rr:parentTriplesMap <#RegionFromCustomerMap> ;
            rr:joinCondition [
                rr:child  "customer_id" ;
                rr:parent "customer_id"
            ]
        ]
    ] .

# Parent triples map referenced by the join above: yields the Region IRI for
# each customer. (It also stands alone as the Region typing for customers.)
<#RegionFromCustomerMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.customers" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Region{region_code}" ;
        rr:class    c360:Region
    ] .

# ===========================================================================
# 6. IDENTITY RECONCILIATION (Step 5)  →  owl:sameAs
#    customer_aliases(legacy_id, canonical_id)
#    Assert that a legacy customer IRI denotes the SAME real-world customer as
#    a canonical one. This is the duplicate-identity fix from Chapter 1, made
#    a declarative fact in the graph rather than a physical merge of rows.
# ===========================================================================
<#CustomerSameAsMap>
    rr:logicalTable [ rr:tableName "ontobricks.customer360.customer_aliases" ] ;
    rr:subjectMap [
        rr:template "https://ontobricks.example/customer360#Customer_{legacy_id}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rr:template "https://ontobricks.example/customer360#Customer{canonical_id}"
        ]
    ] .
