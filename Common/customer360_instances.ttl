@prefix c360: <https://ontobricks.example/customer360#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#################################################################
#  Ontology metadata
#  Knowledge Graphs for AI Agents — Chapter 3 lab artifact.
#  The foundational ontology of the Customer 360 bounded context.
#  Designed to sit within the OWL 2 RL profile so it reasons fast
#  and scales to lakehouse-sized graphs.
#################################################################
<https://ontobricks.example/customer360>
    a owl:Ontology ;
    dct:title       "Customer 360 Ontology" ;
    dct:description """A bounded-context ontology for the customer domain: customers,
                     accounts, orders, products, regions, regulations, support and
                     interactions. Foundational artifact of the Knowledge Graphs for
                     AI Agents digital twin (Chapter 3).""" ;
    owl:versionIRI  <https://ontobricks.example/customer360/0.1.0> ;
    dct:creator     "Customer 360 working group" .
    
#################################################################
#  Canonical instances (running examples reused across the book)
#  Customer4471 is asserted ONLY as a Customer; the reasoner derives
#  PremiumCustomer membership from the defining axiom above.
#################################################################
c360:GDPR a c360:Regulation ;
    rdfs:label "GDPR" ;
    rdfs:comment "EU General Data Protection Regulation; implies EU data residency." .

c360:RegionEMEA a c360:Region ;
    rdfs:label "EMEA" ;
    c360:governedBy c360:GDPR .

c360:Customer4471 a c360:Customer ;
    rdfs:label "Customer 4471" ;
    c360:hasLifetimeValue "18400"^^xsd:decimal ;
    c360:status "active" ;
    c360:isLocatedIn c360:RegionEMEA ;
    c360:placed c360:Order9920 ;
    owl:sameAs c360:cust_88123 .

c360:Order9920 a c360:Order ;
    rdfs:label "Order 9920" .