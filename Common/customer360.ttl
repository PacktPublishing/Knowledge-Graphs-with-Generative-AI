@prefix c360: <https://ontobricks.example/customer360#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#################################################################
#  Ontology metadata
#  Knowledge Graphs for AI Agents — Chapter 3 lab artifact.
#  The foundational ontology of the Customer 360 bounded context.
#  Designed to sit within the OWL 2 RL profile so it reasons fast
#  and scales to lakehouse-sized graphs.
#################################################################
<https://ontobricks.example/customer360>
    a owl:Ontology ;
    dct:title       "Customer 360 Ontology" ;
    dct:description """A bounded-context ontology for the customer domain: customers,
                     accounts, orders, products, regions, regulations, support and
                     interactions. Foundational artifact of the Knowledge Graphs for
                     AI Agents digital twin (Chapter 3).""" ;
    owl:versionIRI  <https://ontobricks.example/customer360/0.1.0> ;
    dct:creator     "Customer 360 working group" .

#################################################################
#  Classes
#################################################################
c360:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A person or organization with a commercial relationship to the business." .

c360:PremiumCustomer a owl:Class ;
    rdfs:label "Premium Customer" ;
    rdfs:comment "A customer whose lifetime value exceeds EUR 15,000. Membership is inferred." ;
    rdfs:subClassOf c360:Customer .

c360:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment "A billing/relationship account held by a customer." .

c360:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A commercial order placed by a customer." .

c360:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A sellable item an order may contain." .

c360:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "A geographic region a customer is located in." .

c360:Regulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "A regulatory regime (e.g. GDPR) that governs a region." .

c360:SupportTicket a owl:Class ;
    rdfs:label "Support Ticket" ;
    rdfs:comment "A support request raised by a customer." .

c360:Interaction a owl:Class ;
    rdfs:label "Interaction" ;
    rdfs:comment "A logged touchpoint between a customer and the business." .

#################################################################
#  Object properties
#################################################################
c360:placed a owl:ObjectProperty ;
    rdfs:label "placed" ; rdfs:comment "A customer placed an order." ;
    rdfs:domain c360:Customer ; rdfs:range c360:Order .

c360:placedBy a owl:ObjectProperty ;
    rdfs:label "placed by" ; rdfs:comment "An order was placed by a customer." ;
    owl:inverseOf c360:placed ;
    rdfs:domain c360:Order ; rdfs:range c360:Customer .

c360:contains a owl:ObjectProperty ;
    rdfs:label "contains" ; rdfs:comment "An order contains a product." ;
    rdfs:domain c360:Order ; rdfs:range c360:Product .

c360:isLocatedIn a owl:ObjectProperty ;
    rdfs:label "is located in" ; rdfs:comment "A customer is located in a region." ;
    rdfs:domain c360:Customer ; rdfs:range c360:Region .

c360:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ; rdfs:comment "A region is governed by a regulation." ;
    rdfs:domain c360:Region ; rdfs:range c360:Regulation .

c360:hasAccount a owl:ObjectProperty ;
    rdfs:label "has account" ; rdfs:comment "A customer holds an account." ;
    rdfs:domain c360:Customer ; rdfs:range c360:Account .

c360:raised a owl:ObjectProperty ;
    rdfs:label "raised" ; rdfs:comment "A customer raised a support ticket." ;
    rdfs:domain c360:Customer ; rdfs:range c360:SupportTicket .

c360:escalatedTo a owl:ObjectProperty ;
    rdfs:label "escalated to" ; rdfs:comment "A support ticket was escalated to an account." ;
    rdfs:domain c360:SupportTicket ; rdfs:range c360:Account .

c360:hadInteraction a owl:ObjectProperty ;
    rdfs:label "had interaction" ; rdfs:comment "A customer had a logged interaction." ;
    rdfs:domain c360:Customer ; rdfs:range c360:Interaction .

#################################################################
#  Datatype properties
#  status & createdAt deliberately have NO rdfs:domain, so the OWL
#  inference licence does not mis-classify accounts/tickets as customers.
#################################################################
c360:hasLifetimeValue a owl:DatatypeProperty ;
    rdfs:label "has lifetime value" ; rdfs:comment "Customer lifetime value, in EUR." ;
    rdfs:domain c360:Customer ; rdfs:range xsd:decimal .

c360:status a owl:DatatypeProperty ;
    rdfs:label "status" ; rdfs:comment "Lifecycle status, e.g. 'active','suspended','closed'." ;
    rdfs:range xsd:string .

c360:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ; rdfs:comment "Creation timestamp." ;
    rdfs:range xsd:dateTime .

#################################################################
#  Restriction: every Order is placed by exactly one Customer
#################################################################
c360:Order rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty c360:placedBy ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass c360:Customer
] .

#################################################################
#  Defining axiom: PremiumCustomer == Customer with LTV > 15000 EUR
#################################################################
c360:PremiumCustomer owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        c360:Customer
        [ a owl:Restriction ;
          owl:onProperty c360:hasLifetimeValue ;
          owl:someValuesFrom [
              a rdfs:Datatype ;
              owl:onDatatype xsd:decimal ;
              owl:withRestrictions ( [ xsd:minExclusive 15000 ] )
          ]
        ]
    )
] .
